      {"id":"v-book","kind":"vocabulary","prompt":"Jak powiesz po angielsku: książka?","answers":["a book","book"],"options":["a book","a cat","a dog"],"explanation":"Książka to „a book”. Przed pojedynczym, policzalnym przedmiotem często używamy „a”.","requires":["demo-1"],"caseSensitive":false},
      {"id":"v-cat","kind":"vocabulary","prompt":"Jak powiesz po angielsku: kot?","answers":["a cat","cat"],"options":["a dog","a cat","a friend"],"explanation":"Kot to „a cat”, a pies to „a dog”.","requires":["demo-1"],"caseSensitive":false},
      {"id":"v-dog","kind":"vocabulary","prompt":"Jak powiesz po angielsku: pies?","answers":["a dog","dog"],"options":["a book","a school","a dog"],"explanation":"Pies to „a dog”. Spróbuj zapamiętać to słowo razem z rodzajnikiem „a”.","requires":["demo-1"],"caseSensitive":false},
      {"id":"v-friend","kind":"vocabulary","prompt":"Jak powiesz po angielsku: przyjaciel lub przyjaciółka?","answers":["a friend","friend"],"options":["a cat","a friend","a book"],"explanation":"„A friend” oznacza zarówno przyjaciela, jak i przyjaciółkę.","requires":["demo-1"],"caseSensitive":false},
      {"id":"v-happy","kind":"vocabulary","prompt":"Jak powiesz po angielsku: szczęśliwa?","answers":["happy"],"options":["school","happy","book"],"explanation":"„Happy” znaczy szczęśliwy lub szczęśliwa. Ta forma nie zależy od płci.","requires":["demo-1"],"caseSensitive":false},
      {"id":"v-school","kind":"vocabulary","prompt":"Jak powiesz po angielsku: szkoła?","answers":["a school","school"],"options":["a friend","a dog","a school"],"explanation":"Szkoła to „a school”. Zwróć uwagę na pisownię: s-c-h-o-o-l.","requires":["demo-1"],"caseSensitive":false},
      {"id":"g-am","kind":"grammar","prompt":"Uzupełnij: I ___ happy.","answers":["am"],"options":["am","is","are"],"explanation":"Z „I” (ja) używamy „am”. „I am happy” oznacza „Jestem szczęśliwa”.","requires":["demo-1"],"caseSensitive":false},
      {"id":"g-is","kind":"grammar","prompt":"Uzupełnij: It ___ a cat.","answers":["is"],"options":["are","am","is"],"explanation":"Z „it” używamy „is”. „It is a cat” oznacza „To jest kot”.","requires":["demo-1"],"caseSensitive":false},
