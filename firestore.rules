rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/history/{pageId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow get: if owner();
      // Immutable archive chunks. No list, update or delete permissions.
      allow create: if owner() && pageId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['format','payload','createdAt'])
        && request.resource.data.keys().hasOnly(['format','payload','createdAt'])
        && request.resource.data.format == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 200000
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/progress/main {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let data = request.resource.data;
        return data.keys().hasAll(['format', 'revision', 'payload', 'updatedAt'])
          && data.keys().hasOnly(['format', 'revision', 'payload', 'updatedAt'])
          && data.format == 1 && data.revision is int && data.revision > 0
          && data.payload is string && data.payload.size() <= 700000
          && data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
